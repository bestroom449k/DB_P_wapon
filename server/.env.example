# 이 파일을 복사해서 이름을 .env로 바꾸고 값을 채우세요.
# .env에는 비밀번호가 들어가므로 git에 올리지 않습니다 (.gitignore에 등록됨).

PORT=3000

# MySQL 접속 정보 (db/schema.sql을 실행한 MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_MySQL_비밀번호
DB_NAME=weapon_game

# 로그인 쿠키 위조를 막는 비밀 값: 아무도 모르는 긴 문자열로 바꾸세요
SESSION_SECRET=change-me-to-a-long-random-string
